# Copy to .env and fill in what you use.

# --- Generation backend: "bedrock" or "groq" -------------------------------
GENERATION_PROVIDER=bedrock

# Amazon Bedrock (uses standard AWS credential resolution: env vars,
# ~/.aws/credentials, SSO, or an instance role)
AWS_REGION=us-east-1
# Amazon Nova needs the cross-region inference profile id ("us." prefix).
# Alternatives: us.amazon.nova-lite-v1:0, us.amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Retrieval core ----------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Leave QDRANT_URL empty for embedded Qdrant persisted at QDRANT_PATH.
# Point it at a server (e.g. http://localhost:6333) for the full quantized
# search path - no code changes.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=sap_notes

TOP_K=5

# --- Knowledge base selection --------------------------------------------------
# Which retrieval backend answers a query by default: "local" (Qdrant above) or
# "bedrock" (Amazon Bedrock Knowledge Base). The chat UI toggle can switch this
# per-request without a restart; leave BEDROCK_KB_ID empty to disable the
# Bedrock option (the toggle grays it out).
KNOWLEDGE_BASE=local
# Bedrock Knowledge Base id (AWS console -> Bedrock -> Knowledge Bases).
# Reuses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above.
BEDROCK_KB_ID=

# --- Ingestion ----------------------------------------------------------------
NOTES_DIR=./data/notes

# --- Citations ------------------------------------------------------------------
SAP_NOTE_URL_TEMPLATE=https://me.sap.com/notes/{note_id}

# --- SAP transactions (MCP server, app/mcp/) -----------------------------------
# Credential source. The SHIPPED build reads SAP credentials from AWS Secrets
# Manager (no secrets in .env). For local iteration, set LOCAL_DEV=true and the
# code reads the SAP_* values below instead - no AWS access needed.
LOCAL_DEV=false
# Secrets Manager secret id/ARN holding {base_url, username, password} as a JSON
# string. Used when LOCAL_DEV is not true. IAM: secretsmanager:GetSecretValue.
SAP_SECRET_NAME=sap-helper/sap-communication-user

# Tenant API host (the -api host, not the UI host). Used only when LOCAL_DEV=true.
SAP_BASE_URL=
# Communication-user credentials (Basic Auth). Used only when LOCAL_DEV=true.
SAP_USERNAME=
SAP_PASSWORD=
# "basic" today; OAuth fields reserved for a config-only swap later.
SAP_AUTH_METHOD=basic
# SAP_OAUTH_CLIENT_ID=
# SAP_OAUTH_CLIENT_SECRET=
# SAP_OAUTH_TOKEN_URL=

# --- Supplier Invoice matching agent (app/mcp/invoice_*.py) --------------------
# Accounts-Payable Supplier Invoice service (OData v2, SAP_COM_0057).
SAP_SUPPLIER_INVOICE_SERVICE=/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV

# Max size of a file attached via the chat composer's + button (bytes).
ATTACHMENT_MAX_BYTES=12582912
# Matching tolerances (a variance is flagged only when it breaches BOTH the
# percentage AND the absolute floor). Overridable at runtime via
# POST /api/invoice/tolerances - no restart.
INVOICE_PRICE_TOLERANCE_PCT=0.02
INVOICE_PRICE_TOLERANCE_ABS=1.00
INVOICE_QUANTITY_TOLERANCE_PCT=0.02
INVOICE_QUANTITY_TOLERANCE_ABS=0.0
# Any critical field (PO no. / item / qty / price) below this confidence routes
# the invoice to the human review queue instead of proceeding on a guess.
INVOICE_CONFIDENCE_THRESHOLD=0.75
# Posting defaults. A 0%-rated input tax code keeps gross == net so the MIRO
# balance check passes; verify against your tax customizing.
INVOICE_DEFAULT_TAX_CODE=V0
INVOICE_ACCOUNTING_DOCUMENT_TYPE=RE

# Variance email (Amazon SES, sandbox mode - only verified addresses receive).
SES_REGION=us-east-1
SES_SENDER=
INVOICE_EMAIL_RECIPIENTS=
INVOICE_EMAIL_MAX_SENDS_PER_RUN=5
# Pin the email language explicitly (do not inherit the RAG language-drift bug).
INVOICE_EMAIL_LANGUAGE=English

# Document defaults - SAP Best Practices US model-company values. Verify
# against YOUR tenant's org structure (see app/mcp/README.md).
SAP_DEFAULT_COMPANY_CODE=1710
SAP_DEFAULT_PURCHASING_ORG=1710
SAP_DEFAULT_PURCHASING_GROUP=001
SAP_DEFAULT_ORDER_TYPE=NB
SAP_DEFAULT_CURRENCY=USD

# MCP transport: "stdio" (default) or "streamable-http" (serves /mcp on the
# host/port below).
SAP_MCP_TRANSPORT=stdio
SAP_MCP_HOST=127.0.0.1
SAP_MCP_PORT=8001
